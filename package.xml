<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>game_controller</name>
  <version>0.0.1</version>
  <description>Controller nodes that decide game_bridge commands from the integrated classifier signal (or, for the dummy, from the keyboard).</description>
  <maintainer email="forin.paolo98@gmail.com">Paolo</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>ros2neuro_msgs</depend>
  <depend>rcl_interfaces</depend>

  <exec_depend>ros2launch</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
